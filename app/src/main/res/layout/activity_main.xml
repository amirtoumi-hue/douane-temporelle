<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_titre_ta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Douane Temporelle"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/et_nom_ta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du voyageur"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/et_naissance_ta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de naissance (ex: 1990)"
        android:inputType="number" />

    <EditText
        android:id="@+id/et_destination_ta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de destination (ex: 2050)"
        android:inputType="number" />

    <TextView
        android:id="@+id/tv_motif_label_ta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Motif du voyage :"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/sp_motif_ta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/motifs_voyage" />

    <Button
        android:id="@+id/btn_inspecter_ta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inspecter le profil"
        android:layout_marginTop="24dp" />
</LinearLayout>